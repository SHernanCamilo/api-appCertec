

# php -- BEGIN cPanel-generated handler, do not edit
# Configure el paquete “ea-php83” como el lenguaje de programación predeterminado “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ─────────────────────────────────────────────────────────────────────────────
# No recomprimir descargas ya comprimidas (xlsx, zip, gzip).
#
# Un .xlsx es un ZIP: si mod_deflate lo re-gzipea, el navegador puede recibir un
# archivo con Content-Length erróneo y guardarlo cortado -> Excel abre
# "reparando y quitando el contenido". Esto excluye esos tipos de la compresión.
# ─────────────────────────────────────────────────────────────────────────────
# NOTA: el DocumentRoot de Apache apunta a public/, asi que Apache NO lee este
# archivo. Las reglas de compresion reales viven en public/.htaccess.
#
# Aqui habia un `Header unset Content-Encoding env=no-gzip`. Se quito porque es
# destructivo: si un filtro (mod_deflate, mod_brotli, el proxy) comprime la
# respuesta, borrar el Content-Encoding deja al navegador con bytes comprimidos
# que no sabe decodificar. El body llega ilegible y sin ninguna pista de por que.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI \.(?:xlsx|xls|zip|gz|gzip)$ no-gzip dont-vary
  SetEnvIfNoCase Request_URI \.(?:xlsx|xls|zip|gz|gzip)$ no-brotli dont-vary
</IfModule>
