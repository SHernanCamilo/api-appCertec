<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # CORS Preflight: dejar que Laravel maneje OPTIONS
    # pero asegurar que el request llegue a index.php
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^ index.php [L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# CORS: asegurar que los headers se envíen en TODAS las respuestas
# (no solo en OPTIONS preflight). Necesario cuando Apache genera
# respuestas intermedias (redirects, errores) antes de llegar a Laravel.
<IfModule mod_headers.c>
    SetEnvIf Origin "https://review-dose-reasonable-pointed\.trycloudflare\.com$" CORS_ORIGIN=$0
    SetEnvIf Origin "https://jade\.medilaser\.com\.co$" CORS_ORIGIN=$0
    SetEnvIf Origin "http://localhost:4200$" CORS_ORIGIN=$0
    SetEnvIf Origin "http://127\.0\.0\.1:4200$" CORS_ORIGIN=$0
    Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin" env=CORS_ORIGIN
</IfModule>

# Compresión gzip — Power Query y Excel soportan Accept-Encoding: gzip
# Reduce ~70% el tamaño de las respuestas OData JSON
#
# application/x-ndjson es el que usa /export/download?as=data para la grilla.
# Antes ese endpoint entregaba un .gz crudo y lo descomprimía el navegador;
# ahora manda texto plano y la compresión la negocian Apache y el navegador con
# Content-Encoding, que es el único mecanismo que los proxies respetan bien.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/x-ndjson
    AddOutputFilterByType DEFLATE text/event-stream
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# No comprimir descargas que YA vienen comprimidas (xlsx, zip, gz).
#
# Un .xlsx es un ZIP: recomprimirlo puede entregarlo con Content-Length errado
# y Excel lo abre "reparando". Y si un filtro comprime la descarga sin que el
# navegador lo sepa, el body llega como binario ilegible.
#
# no-gzip cubre mod_deflate; no-brotli cubre mod_brotli. Hacen falta LOS DOS:
# el .htaccess de la raíz del repo solo ponía no-gzip (y además Apache no lo
# lee, porque el DocumentRoot es public/).
#
# OJO: aquí NO va ningún `Header unset Content-Encoding`. Esa línea existía en
# el .htaccess de la raíz y es destructiva: si un filtro comprime la respuesta,
# borrar el Content-Encoding deja al navegador con bytes comprimidos que no
# sabe decodificar. Era la causa de los datos binarios en el viewer de vistas.
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI \.(?:xlsx|xls|zip|gz|gzip)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \.(?:xlsx|xls|zip|gz|gzip)$ no-brotli dont-vary

    # /export/download/{jobId}?as=file entrega el .xlsx y no lleva extensión en
    # la URL, así que la regla de arriba no lo cubre. ?as=data (NDJSON) sí se
    # comprime: es texto y ahí el ahorro interesa.
    SetEnvIf Query_String "as=file" no-gzip dont-vary
    SetEnvIf Query_String "as=file" no-brotli dont-vary
</IfModule>

# SSE (Server-Sent Events) — desactivar buffering para export stream
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#/api/fabric/viewer/export/stream/#">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set X-Accel-Buffering "no"
    </If>
</IfModule>
<IfModule mod_env.c>
    SetEnvIf Request_URI "/api/fabric/viewer/export/stream/" no-gzip
</IfModule>