<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compresión gzip — Power Query y Excel soportan Accept-Encoding: gzip
# Reduce ~70% el tamaño de las respuestas OData JSON
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/event-stream
</IfModule>

# SSE (Server-Sent Events) — desactivar buffering para export stream
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#/api/fabric/viewer/export/stream/#">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set X-Accel-Buffering "no"
    </If>
</IfModule>
<IfModule mod_env.c>
    SetEnvIf Request_URI "/api/fabric/viewer/export/stream/" no-gzip
</IfModule>